{
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.py": true,
        "**/*.pyo": true,
        "**/*.pyd": true,
        "**/*.pdb": true,
        "**/*.egg": true,
        "**/*.egg-info": true,
        "**/dist": true,
        "**/build": true,
        "**/pip-wheel-metadata": true,
        "**/*.spec": true,
        "**/env": true,
        "**/venv": true,
        "**/.venv": true,
        "**/ENV": true,
        "**/env_playwright": true,
        "**/playwright-report": true,
        "**/playwright/.cache": true,
